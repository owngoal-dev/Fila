        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「顯示隱藏檔案」即可看到它們。"
          }
        }
      }
    },
    "Turning off Remember Recents also deletes the history already recorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف «تذكّر العناصر الأخيرة» يحذف أيضًا السجل المسجَّل بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zuletzt benutzte merken“ auszuschalten löscht auch den bereits aufgezeichneten Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning off Remember Recents also deletes the history already recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar «Recordar los recientes» también elimina el historial ya registrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver « Mémoriser les récents » supprime aussi l’historique déjà enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivare «Ricorda i recenti» elimina anche la cronologia già registrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近の項目を記憶」をオフにすると、記録済みの履歴も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘최근 항목 기억’을 끄면 이미 기록된 기록도 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar “Lembrar Recentes” também apaga o histórico já registrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключение параметра «Запоминать недавние» также удаляет уже записанную историю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt “Ghi nhớ mục gần đây” cũng xóa lịch sử đã ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“记录最近使用”也会删除已经记录的历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉「記住最近項目」也會刪除已經記錄的歷史。"
          }
        }
