          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте, чтобы изменить порядок. Выключите место, чтобы скрыть его."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
