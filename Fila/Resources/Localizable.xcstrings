    "Transferring between servers needs %@ of free space on this device for a temporary copy, and only %@ is free. Free up space and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Transferring between servers needs %1$@ of free space on this device for a temporary copy, and only %2$@ is free. Free up space and try again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب النقل بين الخوادم مساحة خالية قدرها %1$@ على هذا الجهاز لنسخة مؤقتة، ولا يتوفر سوى %2$@. أفرغ بعض المساحة وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Übertragung zwischen Servern werden %1$@ freier Speicher auf diesem Gerät für eine temporäre Kopie benötigt, es sind aber nur %2$@ frei. Gib Speicher frei und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferir entre servidores necesita %1$@ de espacio libre en este dispositivo para una copia temporal, y solo hay %2$@ libres. Libera espacio y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un transfert entre serveurs nécessite %1$@ d’espace libre sur cet appareil pour une copie temporaire, or il n’y a que %2$@ de libre. Libérez de l’espace, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trasferimento tra server richiede %1$@ di spazio libero su questo dispositivo per una copia temporanea, ma sono liberi solo %2$@. Libera spazio e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバ間の転送には、一時コピー用にこのデバイスの空き容量が %1$@ 必要ですが、空きは %2$@ しかありません。空き容量を増やしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 간 전송에는 임시 사본을 위해 이 기기에 %1$@의 여유 공간이 필요하지만 %2$@만 남아 있습니다. 공간을 확보한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferir entre servidores precisa de %1$@ de espaço livre neste dispositivo para uma cópia temporária, e há apenas %2$@ livres. Libere espaço e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для передачи между серверами на этом устройстве нужно %1$@ свободного места для временной копии, а свободно только %2$@. Освободите место и повторите попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc truyền giữa các máy chủ cần %1$@ dung lượng trống trên thiết bị này cho bản sao tạm thời, nhưng chỉ còn %2$@. Hãy giải phóng dung lượng rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器之间传输需要此设备有 %1$@ 可用空间用于临时副本，但当前仅剩 %2$@。请释放空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在伺服器之間傳輸需要此裝置有 %1$@ 可用空間存放暫存副本，但目前僅剩 %2$@。請釋出空間後再試一次。"
          }
        }
      }
    },
