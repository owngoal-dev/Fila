    },
    "The source and destination refer to the same item, even though their paths differ. Choose another destination." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير المصدر والوجهة إلى العنصر نفسه رغم اختلاف المسارين. اختر وجهة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle und Ziel verweisen auf dasselbe Objekt, obwohl sich ihre Pfade unterscheiden. Wähle ein anderes Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source and destination refer to the same item, even though their paths differ. Choose another destination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El origen y el destino son el mismo elemento, aunque sus rutas sean distintas. Selecciona otro destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la destination désignent le même élément, même si leurs chemins diffèrent. Choisissez une autre destination."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’origine e la destinazione indicano lo stesso elemento, anche se i percorsi sono diversi. Scegli un’altra destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスは異なりますが、元の項目と移動先は同じ項目を指しています。別の移動先を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로는 다르지만 원본과 대상이 같은 항목을 가리킵니다. 다른 대상 위치를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A origem e o destino se referem ao mesmo item, mesmo com caminhos diferentes. Escolha outro destino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник и назначение указывают на один и тот же объект, хотя их пути различаются. Выберите другое назначение."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguồn và đích cùng trỏ tới một mục, dù đường dẫn khác nhau. Hãy chọn đích khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
