        }
      }
    },
    "The folder “%@” is not empty and cannot be replaced. Rename it or choose another folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجلد ”%@“ ليس فارغًا ولا يمكن استبداله. أعد تسميته أو اختر مجلدًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
