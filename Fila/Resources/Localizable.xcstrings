{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” already exists at the destination. Rename it or choose another folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@“ موجود بالفعل في الوجهة. أعد تسميته أو اختر مجلدًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ existiert am Ziel bereits. Benenne es um oder wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” already exists at the destination. Rename it or choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya existe en el destino. Cámbiale el nombre o elige otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » existe déjà dans la destination. Renommez-le ou choisissez un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” esiste già nella destinazione. Rinominalo o scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は保存先にすでに存在します。名前を変更するか、別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 대상에 이미 있습니다. 이름을 바꾸거나 다른 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já existe no destino. Renomeie-o ou escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже есть в месте назначения. Переименуйте его или выберите другую папку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đã tồn tại ở đích. Hãy đổi tên hoặc chọn thư mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”在目标位置已存在。重命名或选择其他文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在目標位置已存在。請重新命名或選擇其他檔案夾。"
          }
        }
      }
    },
    "“%@” could not be read as text. Choose a text file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة ”%@“ كنص. اختر ملفًا نصيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als Text gelesen werden. Wähle eine Textdatei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” could not be read as text. Choose a text file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer “%@” como texto. Selecciona un archivo de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire « %@ » comme du texte. Choisissez un fichier texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere “%@” come testo. Scegli un file di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をテキストとして読み込めませんでした。テキストファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 텍스트로 읽을 수 없습니다. 텍스트 파일을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler “%@” como texto. Escolha um arquivo de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать «%@» как текст. Выберите текстовый файл."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc “%@” dưới dạng văn bản. Hãy chọn một tệp văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将“%@”读取为文本，选择文本文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將「%@」讀取為文字。請選擇文字檔案。"
          }
        }
      }
    },
    "“%@” holds too many items to list. Use the Find Files action instead." : {
      "comment" : "Why the List Folder shortcut refused: the folder is past the listing cap. %@ is the folder's path, Find Files the name of another Fila shortcut.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي ”%@“ على عناصر أكثر من أن تُدرج. استخدم إجراء Find Files بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ enthält zu viele Objekte für eine Auflistung. Verwende stattdessen die Aktion „Dateien suchen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” holds too many items to list. Use the Find Files action instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” contiene demasiados elementos para listarlos. Usa la acción Buscar archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » contient trop d’éléments pour être listé. Utilisez plutôt l’action Rechercher des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” contiene troppi elementi per essere elencato. Usa invece l’azione Trova file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は項目が多すぎて一覧を作成できません。代わりに「ファイルを検索」アクションを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 항목이 너무 많아 목록을 표시할 수 없습니다. 대신 파일 찾기 동작을 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” contém itens demais para listar. Use a ação Buscar Arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «%@» слишком много объектов, чтобы показать их списком. Используйте вместо этого действие «Найти файлы»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” chứa quá nhiều mục để liệt kê. Hãy dùng tác vụ Tìm tệp thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”中的项目太多，无法列出。请改用“查找文件”操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」中的項目過多，無法列出。請改用「尋找檔案」動作。"
          }
        }
      }
    },
    "“%@” is %@ at the destination instead of %@. The original was kept. Look in the destination folder before trying again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is %2$@ at the destination instead of %3$@. The original was kept. Look in the destination folder before trying again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@“ في الوجهة هو %2$@ بدلًا من %3$@. تم الاحتفاظ بالأصل. تحقق من مجلد الوجهة قبل المحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist am Ziel %2$@ statt %3$@. Das Original wurde behalten. Sieh im Zielordner nach, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” es %2$@ en el destino en lugar de %3$@. Se ha conservado el original. Comprueba la carpeta de destino antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est %2$@ dans la destination au lieu de %3$@. L’original a été conservé. Vérifiez le dossier de destination avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” nella destinazione è %2$@ invece di %3$@. L’originale è stato mantenuto. Controlla la cartella di destinazione prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は移動先では%3$@ではなく%2$@です。元の項目はそのまま残しました。移動先のフォルダを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 위치의 “%1$@”은(는) %3$@이 아니라 %2$@입니다. 원본은 유지되었습니다. 다시 시도하기 전에 대상 폴더를 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” está no destino como %2$@ em vez de %3$@. O original foi mantido. Verifique a pasta de destino antes de tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» в месте назначения — это %2$@, а не %3$@. Оригинал сохранён. Проверьте папку назначения, прежде чем повторить попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ở đích là %2$@ chứ không phải %3$@. Bản gốc đã được giữ lại. Hãy kiểm tra thư mục đích trước khi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”在目标位置是%2$@，而不是%3$@。已保留原项目。请先查看目标文件夹，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」在目標位置是%2$@，而不是%3$@。已保留原項目。請先查看目標檔案夾，然後再試一次。"
          }
        }
      }
    },
    "“%@” is Fila itself and cannot be installed from here. Install it with your package manager." : {
      "comment" : "Error shown when Install… is used on Fila's own .deb: the daemon's own restart would kill dpkg mid-configure. %@ is the file name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@“ هو Fila نفسه ولا يمكن تثبيته من هنا. ثبّته باستخدام مدير الحزم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist Fila selbst und kann nicht von hier installiert werden. Installiere es mit deinem Paketmanager."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is Fila itself and cannot be installed from here. Install it with your package manager."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” es la propia app Fila y no se puede instalar desde aquí. Instálala con tu gestor de paquetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est Fila lui-même et ne peut pas être installé d’ici. Installez-le avec votre gestionnaire de paquets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è Fila stesso e non può essere installato da qui. Installalo con il tuo gestore di pacchetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はFila自身のため、ここからはインストールできません。パッケージマネージャからインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) Fila 자신이므로 여기에서 설치할 수 없습니다. 패키지 관리자로 설치하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é o próprio Fila e não pode ser instalado daqui. Instale-o com seu gerenciador de pacotes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — это сам Fila, его нельзя установить отсюда. Установите его через менеджер пакетов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” chính là Fila và không thể cài đặt từ đây. Hãy cài đặt bằng trình quản lý gói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是 Fila 自身，无法从这里安装。请使用系统软件包管理器安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是 Fila 本身，無法從這裡安裝。請使用系統套件管理器安裝。"
          }
        }
      }
    },
