    "Writes text to a file as root, replacing its contents and keeping its permissions, owner and dates." : {
      "comment" : "What the Write Text to File shortcut does, shown in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب نصًا إلى ملف بصلاحية الجذر، مستبدلًا محتوياته ومحتفظًا بأذوناته ومالكه وتواريخه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt Text als Root in eine Datei, ersetzt ihren Inhalt und behält Zugriffsrechte, Eigentümer und Datumsangaben bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes text to a file as root, replacing its contents and keeping its permissions, owner and dates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe texto en un archivo como root, sustituyendo su contenido y conservando sus permisos, propietario y fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit du texte dans un fichier en tant que root, en remplaçant son contenu et en conservant ses autorisations, son propriétaire et ses dates."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive del testo in un file come root, sostituendone il contenuto e mantenendo permessi, proprietario e date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rootとしてファイルにテキストを書き込み、内容を置き換えます。アクセス権、所有者、日付は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "루트 권한으로 파일에 텍스트를 씁니다. 내용은 대치되고 권한, 소유자 및 날짜는 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava texto em um arquivo como root, substituindo o conteúdo e mantendo as permissões, o proprietário e as datas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает текст в файл от имени root, заменяя его содержимое и сохраняя права доступа, владельца и даты."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi văn bản vào một tệp với quyền root, thay thế nội dung và giữ nguyên quyền, chủ sở hữu và ngày tháng của tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 身份将文本写入文件，替换其内容，并保留权限、所有者和日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 權限將文字寫入檔案，取代其內容並保留權限、擁有者和日期。"
          }
        }
      }
    },
