    "AES-256 provides strong encryption, but some older tools cannot open these archives." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفّر AES-256 تشفيرًا قويًا، لكن بعض الأدوات الأقدم لا يمكنها فتح هذه الأرشيفات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 bietet starke Verschlüsselung, aber manche älteren Programme können diese Archive nicht öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 provides strong encryption, but some older tools cannot open these archives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 ofrece un cifrado seguro, pero algunas herramientas antiguas no pueden abrir estos archivos comprimidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 offre un chiffrement robuste, mais certains outils anciens ne peuvent pas ouvrir ces archives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 offre una crittografia forte, ma alcuni strumenti meno recenti non riescono ad aprire questi archivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256は強力な暗号化ですが、一部の古いツールではこのアーカイブを開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256은 강력한 암호화를 제공하지만, 일부 오래된 도구에서는 이 아카이브를 열 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AES-256 oferece criptografia forte, mas algumas ferramentas antigas não conseguem abrir esses arquivos compactados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 обеспечивает надёжное шифрование, но некоторые старые программы не могут открыть такие архивы."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 mã hóa mạnh, nhưng một số công cụ cũ không mở được các kho lưu trữ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 提供高强度加密，但部分旧版工具无法打开此类压缩包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256 提供高強度加密，但部分較舊的工具無法打開這類壓縮檔。"
          }
        }
      }
    },
    "An item with this name already exists. Replacing it cannot be undone — the replaced item does not go to the trash." : {
      "comment" : "Rename confirmation. Blunt on purpose: it precedes something irreversible.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد عنصر بهذا الاسم بالفعل. لا يمكن التراجع عن استبداله — العنصر المستبدل لا يذهب إلى المهملات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Objekt mit diesem Namen existiert bereits. Das Ersetzen kann nicht widerrufen werden – das ersetzte Objekt landet nicht im Papierkorb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An item with this name already exists. Replacing it cannot be undone — the replaced item does not go to the trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un elemento con este nombre. Sustituirlo no se puede deshacer: el elemento sustituido no va a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément portant ce nom existe déjà. Le remplacer est irréversible — l’élément remplacé ne va pas dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un elemento con questo nome. La sostituzione non può essere annullata: l’elemento sostituito non finisce nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前の項目はすでに存在します。置き換えは取り消せません。置き換えられた項目はゴミ箱に入りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 이름의 항목이 이미 있습니다. 대치하면 되돌릴 수 없으며, 대치된 항목은 휴지통으로 가지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um item com esse nome. Substituí-lo não pode ser desfeito — o item substituído não vai para a Lixeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объект с таким именем уже существует. Замену нельзя отменить — заменённый объект не попадает в Корзину."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có mục trùng tên. Việc thay thế không thể hoàn tác — mục bị thay thế không vào thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存在同名项目。替换后无法撤销——被替换的项目不会进入废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有相同名稱的項目。取代後無法復原——被取代的項目不會移到垃圾桶。"
          }
        }
      }
    },
