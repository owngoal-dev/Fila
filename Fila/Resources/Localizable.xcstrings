    "Stopped when Fila closed. Check for incomplete files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت عند إغلاق Fila. تحقق من وجود ملفات غير مكتملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Beenden von Fila gestoppt. Prüfe auf unvollständige Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped when Fila closed. Check for incomplete files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo al cerrarse Fila. Comprueba si hay archivos incompletos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté à la fermeture de Fila. Vérifiez s’il y a des fichiers incomplets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrotto alla chiusura di Fila. Controlla se ci sono file incompleti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filaの終了時に停止しました。不完全なファイルがないか確認してください。"
