    "Copy keeps the originals. Move takes them out of their current folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخ يُبقي العناصر الأصلية. النقل يُخرجها من مجلدها الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
