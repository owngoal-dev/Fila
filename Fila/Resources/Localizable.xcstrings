        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu kho lưu trữ bị thiếu hoặc không đúng. Hãy nhập mật khẩu rồi thử lại."
          }
        },
        "zh-Hans" : {
