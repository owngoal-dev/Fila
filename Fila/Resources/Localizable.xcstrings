            "value" : "「%@」不是檔案夾。請選擇檔案夾。"
          }
        }
      }
    },
    "“%@” is not a valid bundle identifier. Enter a different identifier." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@“ ليس معرّف حزمة صالحًا. أدخل معرّفًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine gültige Bundle-ID. Gib eine andere ID ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is not a valid bundle identifier. Enter a different identifier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un identificador de paquete válido. Introduce otro identificador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un identifiant de bundle valide. Saisissez un autre identifiant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un identificatore di bundle valido. Inserisci un identificatore diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は有効なバンドル識別子ではありません。別の識別子を入力してください。"
          }
