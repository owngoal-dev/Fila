    "A file and a folder have the same name at the destination. Rename one or choose another folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد ملف ومجلد بالاسم نفسه في الوجهة. غيّر اسم أحدهما أو اختر مجلدًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Ziel haben eine Datei und ein Ordner denselben Namen. Benenne eines davon um oder wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file and a folder have the same name at the destination. Rename one or choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el destino hay un archivo y una carpeta con el mismo nombre. Cambia el nombre de uno o selecciona otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier et un dossier portent le même nom à la destination. Renommez-en un ou choisissez un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file e una cartella hanno lo stesso nome nella destinazione. Rinominane uno o scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動先にファイルとフォルダが同じ名前で存在します。どちらかの名前を変更するか、別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 위치에 이름이 같은 파일과 폴더가 있습니다. 하나의 이름을 바꾸거나 다른 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo e uma pasta têm o mesmo nome no destino. Renomeie um deles ou escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В папке назначения файл и папка имеют одинаковое имя. Переименуйте один из них или выберите другую папку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tệp và một thư mục trùng tên tại đích. Hãy đổi tên một trong hai hoặc chọn thư mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标位置存在同名的文件或文件夹，类型不同，无法替换。请先重命名或选择其他文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標位置存在同名的檔案或檔案夾，類型不同，無法取代。請先重新命名或選擇其他檔案夾。"
          }
        }
      }
    },
    "A folder cannot be copied or moved into itself or one of its subfolders. Choose a destination outside this folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن نسخ مجلد أو نقله إلى داخل نفسه أو إلى أحد مجلداته الفرعية. اختر وجهة خارج هذا المجلد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ordner kann nicht in sich selbst oder einen seiner Unterordner kopiert oder bewegt werden. Wähle ein Ziel außerhalb dieses Ordners."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder cannot be copied or moved into itself or one of its subfolders. Choose a destination outside this folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carpeta no se puede copiar ni mover dentro de sí misma ni de sus subcarpetas. Selecciona un destino fuera de esta carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dossier ne peut pas être copié ni déplacé dans lui-même ou dans l’un de ses sous-dossiers. Choisissez une destination en dehors de ce dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi copiare o spostare una cartella al suo interno o in una sua sottocartella. Scegli una destinazione esterna a questa cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダを、それ自身またはそのサブフォルダの中にコピーまたは移動することはできません。このフォルダの外にある移動先を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더를 자기 자신이나 하위 폴더로 복사하거나 이동할 수 없습니다. 이 폴더 밖의 대상 위치를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível copiar ou mover uma pasta para dentro dela mesma ou de uma de suas subpastas. Escolha um destino fora desta pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папку нельзя скопировать или переместить в саму себя или в свою вложенную папку. Выберите папку за пределами этой папки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể sao chép hoặc di chuyển một thư mục vào chính nó hoặc thư mục con của nó. Hãy chọn đích nằm ngoài thư mục này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不能将文件夹拷贝或移动到自身或其子文件夹中。请选择此文件夹以外的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將檔案夾拷貝或搬移至自身或其子檔案夾中。請選擇此檔案夾以外的位置。"
          }
        }
      }
    },
