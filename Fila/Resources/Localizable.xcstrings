    "Copy %@ into %@?" : {
      "comment" : "Confirmation before the Copy Item shortcut runs. The first %@ is the source, the second the destination folder, both as the daemon resolved them.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ %1$@ إلى %2$@؟"
