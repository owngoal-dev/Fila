        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila가 종료되면서 중단되었습니다. 불완전한 파일이 없는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
