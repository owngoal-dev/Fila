    "Two selected items are both named “%@” and would use the same destination. Rename one or transfer them separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنصران محددان يحملان الاسم ”%@“ نفسه وسيستخدمان الوجهة نفسها. أعد تسمية أحدهما أو انقلهما بشكل منفصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei ausgewählte Objekte heißen beide „%@“ und würden dasselbe Ziel verwenden. Benenne eines um oder übertrage sie getrennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two selected items are both named “%@” and would use the same destination. Rename one or transfer them separately."
          }
