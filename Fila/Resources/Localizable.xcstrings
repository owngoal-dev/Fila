    "Items on this server can be copied but not moved. They cannot be deleted from this location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن نسخ العناصر على هذا الخادم لكن لا يمكن نقلها. لا يمكن حذفها من هذا الموقع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte auf diesem Server können kopiert, aber nicht bewegt werden. Von diesem Ort können sie nicht gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items on this server can be copied but not moved. They cannot be deleted from this location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos de este servidor se pueden copiar, pero no mover. No se pueden eliminar de esta ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments de ce serveur peuvent être copiés mais pas déplacés. Ils ne peuvent pas être supprimés de cet emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi su questo server possono essere copiati ma non spostati. Non possono essere eliminati da questa posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバ上の項目はコピーできますが移動はできません。この場所からは削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버의 항목은 복사할 수 있지만 이동할 수 없습니다. 이 위치에서는 삭제할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens neste servidor podem ser copiados, mas não movidos. Eles não podem ser apagados deste local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объекты на этом сервере можно копировать, но не перемещать. Их нельзя удалить из этого расположения."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục trên máy chủ này có thể sao chép nhưng không thể di chuyển. Không thể xóa chúng khỏi vị trí này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器上的项目可以复制但不能移动。无法从此位置删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此伺服器上的項目可以拷貝，但無法搬移。無法從此位置刪除。"
          }
        }
      }
    },
    "Items with the same names will be replaced, not moved to the trash. This cannot be undone. Non-empty folders cannot be replaced." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم استبدال العناصر التي تحمل الأسماء نفسها، ولن تُنقل إلى المهملات. لا يمكن التراجع عن هذا. لا يمكن استبدال المجلدات غير الفارغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte mit gleichen Namen werden ersetzt, nicht in den Papierkorb bewegt. Das kann nicht widerrufen werden. Nicht leere Ordner können nicht ersetzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items with the same names will be replaced, not moved to the trash. This cannot be undone. Non-empty folders cannot be replaced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos con el mismo nombre se sustituirán; no se moverán a la papelera. Esto no se puede deshacer. Las carpetas que no estén vacías no se pueden sustituir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments portant le même nom seront remplacés, pas placés dans la corbeille. Cette action est irréversible. Les dossiers non vides ne peuvent pas être remplacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi con lo stesso nome verranno sostituiti, non spostati nel Cestino. Questa operazione non può essere annullata. Le cartelle non vuote non possono essere sostituite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前の項目は、ゴミ箱に入らず置き換えられます。この操作は取り消せません。空でないフォルダは置き換えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름이 같은 항목은 휴지통으로 이동되지 않고 대치됩니다. 이 작업은 되돌릴 수 없습니다. 비어 있지 않은 폴더는 대치할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens com os mesmos nomes serão substituídos, não movidos para a Lixeira. Isso não pode ser desfeito. Pastas não vazias não podem ser substituídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объекты с такими же именами будут заменены, а не перемещены в Корзину. Это нельзя отменить. Непустые папки заменить нельзя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục trùng tên sẽ bị thay thế chứ không được chuyển vào thùng rác. Việc này không thể hoàn tác. Không thể thay thế thư mục không rỗng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同名项目将被替换，不会移入废纸篓。此操作无法撤销。无法替换非空文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同名項目會被取代，而不會移到垃圾桶。此操作無法復原。非空的檔案夾無法被取代。"
          }
        }
      }
    },
    "Items you copy or move wait here until you paste them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناصر التي تنسخها أو تنقلها تنتظر هنا حتى تلصقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte, die du kopierst oder bewegst, warten hier, bis du sie einsetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items you copy or move wait here until you paste them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos que copies o muevas esperan aquí hasta que los pegues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments que vous copiez ou déplacez attendent ici jusqu’à ce que vous les colliez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi che copi o sposti restano qui finché non li incolli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーまたは移動した項目は、ペーストするまでここで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사하거나 이동한 항목은 붙여넣을 때까지 여기에서 대기합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens que você copia ou move ficam aqui até você colá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объекты, которые вы копируете или перемещаете, ждут здесь, пока вы их не вставите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục bạn sao chép hoặc di chuyển sẽ chờ ở đây cho đến khi bạn dán chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝或移动的项目会保留在这里，直到你粘贴它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拷貝或移動的項目會留在這裡，直到你將它們貼上。"
          }
        }
      }
    },
    "Its saved password and favorites are forgotten. Nothing on the server is changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنسى كلمة سره المحفوظة ومفضلاته. لا يُغيَّر شيء على الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichertes Passwort und Favoriten werden vergessen. Auf dem Server wird nichts verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its saved password and favorites are forgotten. Nothing on the server is changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se olvidan su contraseña guardada y sus favoritos. No se modifica nada en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son mot de passe enregistré et ses favoris sont oubliés. Rien n’est modifié sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password salvata e i preferiti vengono dimenticati. Nulla sul server viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したパスワードとお気に入りは忘れられます。サーバ上のものは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 암호와 즐겨찾기가 삭제됩니다. 서버의 내용은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha e os favoritos salvos são esquecidos. Nada no servidor é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый пароль и избранное будут забыты. На сервере ничего не изменится."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu đã lưu và mục ưa thích sẽ bị quên. Không có gì trên máy chủ bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的密码和收藏将被清除。服务器上的内容不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的密碼和收藏將被忘記。伺服器上的內容不會變更。"
          }
        }
      }
    },
