        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos elementos seleccionados se llaman “%@” y usarían el mismo destino. Cambia el nombre de uno o transfiérelos por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux éléments sélectionnés portent le nom « %@ » et utiliseraient la même destination. Renommez-en un ou transférez-les séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due elementi selezionati si chiamano entrambi “%@” e userebbero la stessa destinazione. Rinominane uno o trasferiscili separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した項目のうち 2 つが「%@」という同じ名前で、同じ保存先になります。一方の名前を変更するか、別々に転送してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 항목 두 개의 이름이 모두 “%@”이어서 같은 대상을 사용하게 됩니다. 하나의 이름을 바꾸거나 따로 전송하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois itens selecionados se chamam “%@” e usariam o mesmo destino. Renomeie um ou transfira-os separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два выбранных объекта называются «%@» и попали бы в одно место. Переименуйте один или перенесите их по отдельности."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai mục đã chọn đều có tên “%@” và sẽ dùng cùng một đích. Hãy đổi tên một mục hoặc chuyển riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
