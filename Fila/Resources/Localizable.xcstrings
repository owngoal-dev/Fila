    "Point another device's camera at the code to open Fila in its browser." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجّه كاميرا جهاز آخر نحو الرمز لفتح Fila في متصفحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera eines anderen Geräts auf den Code, um Fila in dessen Browser zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point another device's camera at the code to open Fila in its browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta con la cámara de otro dispositivo al código para abrir Fila en su navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez l’appareil photo d’un autre appareil vers le code pour ouvrir Fila dans son navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice con la fotocamera di un altro dispositivo per aprire Fila nel suo browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスのカメラをコードに向けると、そのブラウザでFilaを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기의 카메라로 코드를 비추면 그 기기의 브라우저에서 Fila가 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera de outro dispositivo para o código para abrir o Fila no navegador dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру другого устройства на код, чтобы открыть Fila в его браузере."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy hướng camera của thiết bị khác vào mã này để mở Fila trong trình duyệt của thiết bị đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一台设备的相机对准二维码，即可在其浏览器中打开 Fila。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一部裝置的相機對準此條碼，即可在其瀏覽器中打開 Fila。"
          }
        }
      }
    },
