    "Your files stay where they are. You will have nothing left to paste." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى ملفاتك في مكانها. لن يتبقى لديك شيء للصقه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Dateien bleiben, wo sie sind. Es bleibt nichts mehr zum Einsetzen übrig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your files stay where they are. You will have nothing left to paste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus archivos se quedan donde están. No te quedará nada que pegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fichiers restent où ils sont. Vous n’aurez plus rien à coller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi file restano dove sono. Non avrai più nulla da incollare."
          }
