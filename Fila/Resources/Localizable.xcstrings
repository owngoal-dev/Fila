    "Fila does not have permission to do this." : {
      "comment" : "Failure message when the operation was refused for lack of permission. The system's own reason follows on the next line.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يملك Fila إذنًا للقيام بذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila hat dafür keine Berechtigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila does not have permission to do this."
          }
        },
        "es" : {
