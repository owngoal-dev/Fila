    "Showing the first %@ of %@. This file is too large to edit. Open it as Hex to see the rest." : {
      "comment" : "Notice above a truncated text file. The first size is what is shown, the second the file's full size. Hex is the name of Fila's hex viewer.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض أول %1$@ من أصل %2$@. هذا الملف أكبر من أن يُحرَّر. افتحه بصيغة Hex لرؤية الباقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden die ersten %1$@ von %2$@ angezeigt. Diese Datei ist zu groß zum Bearbeiten. Öffne sie als „Hex“, um den Rest zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing the first %1$@ of %2$@. This file is too large to edit. Open it as Hex to see the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestran los primeros %1$@ de %2$@. Este archivo es demasiado grande para editarlo. Ábrelo como Hex para ver el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage des %1$@ premiers sur %2$@. Ce fichier est trop volumineux pour être modifié. Ouvrez-le en Hex pour voir le reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono mostrati i primi %1$@ di %2$@. Questo file è troppo grande per essere modificato. Aprilo come Hex per vedere il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先頭の%1$@を表示しています（全%2$@）。このファイルは大きすぎて編集できません。残りを見るにはHexとして開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@만 표시하고 있습니다(전체 %2$@). 이 파일은 너무 커서 편집할 수 없습니다. 나머지를 보려면 Hex로 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibindo os primeiros %1$@ de %2$@. Este arquivo é grande demais para editar. Abra-o como Hex para ver o restante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показаны первые %1$@ из %2$@. Этот файл слишком велик для редактирования. Откройте его как Hex, чтобы увидеть остальное."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị %1$@ đầu tiên trong tổng số %2$@. Tệp này quá lớn để chỉnh sửa. Hãy mở dạng Hex để xem phần còn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅显示前 %1$@，文件共 %2$@。此文件太大，无法编辑。以十六进制打开可查看其余部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅顯示前 %1$@，檔案共 %2$@。此檔案太大，無法編輯。請以「十六進位」打開來查看其餘內容。"
          }
        }
      }
    },
