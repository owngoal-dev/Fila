        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановлено при закрытии Fila. Проверьте, не осталось ли незавершённых файлов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
