    },
    "The destination folder is not empty and cannot be replaced. Rename the item or choose another folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد الوجهة غير فارغ ولا يمكن استبداله. غيّر اسم العنصر أو اختر مجلدًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zielordner ist nicht leer und kann nicht ersetzt werden. Benenne das Objekt um oder wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The destination folder is not empty and cannot be replaced. Rename the item or choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de destino no está vacía y no se puede sustituir. Cambia el nombre del elemento o selecciona otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de destination n’est pas vide et ne peut pas être remplacé. Renommez l’élément ou choisissez un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella di destinazione non è vuota e non può essere sostituita. Rinomina l’elemento o scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動先のフォルダは空ではないため、置き換えられません。項目の名前を変更するか、別のフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 폴더가 비어 있지 않아 대치할 수 없습니다. 항목의 이름을 바꾸거나 다른 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta de destino não está vazia e não pode ser substituída. Renomeie o item ou escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка назначения не пуста, и заменить её нельзя. Переименуйте объект или выберите другую папку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục đích không rỗng nên không thể thay thế. Hãy đổi tên mục hoặc chọn thư mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标文件夹不为空，无法替换。请重命名项目或选择其他文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標檔案夾不是空的，無法取代。請重新命名項目或選擇其他檔案夾。"
          }
        }
      }
    },
    "The destination is read-only. Choose a writable folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوجهة للقراءة فقط. اختر مجلدًا قابلًا للكتابة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel ist schreibgeschützt. Wähle einen beschreibbaren Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The destination is read-only. Choose a writable folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino es de solo lectura. Selecciona una carpeta en la que se pueda escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destination est en lecture seule. Choisissez un dossier accessible en écriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destinazione è di sola lettura. Scegli una cartella scrivibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動先は読み出し専用です。書き込み可能なフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 위치는 읽기 전용입니다. 쓸 수 있는 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O destino é somente leitura. Escolha uma pasta com permissão de escrita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка назначения доступна только для чтения. Выберите папку с правом записи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đích chỉ đọc. Hãy chọn một thư mục có thể ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标位置为只读。请选择可写入的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標位置為唯讀。請選擇可寫入的檔案夾。"
          }
        }
      }
    },
    "The device needs this item to start up, so Fila will not delete, move or replace it. You can still edit what is inside it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج الجهاز إلى هذا العنصر لبدء التشغيل، لذا لن يحذفه Fila أو ينقله أو يستبدله. لا يزال بإمكانك تحرير ما بداخله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät braucht dieses Objekt zum Starten, daher wird Fila es nicht löschen, bewegen oder ersetzen. Den Inhalt kannst du weiterhin bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device needs this item to start up, so Fila will not delete, move or replace it. You can still edit what is inside it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo necesita este elemento para arrancar, así que Fila no lo eliminará, moverá ni sustituirá. Sí puedes editar lo que hay dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil a besoin de cet élément pour démarrer : Fila ne le supprimera pas, ne le déplacera pas et ne le remplacera pas. Vous pouvez toujours modifier ce qu’il contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo ha bisogno di questo elemento per avviarsi, quindi Fila non lo elimina, non lo sposta e non lo sostituisce. Puoi comunque modificare ciò che contiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの起動にはこの項目が必要なため、Filaはこれを削除、移動、置き換えしません。中身の編集は引き続き行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기를 시동하려면 이 항목이 필요하므로, Fila는 이 항목을 삭제하거나 이동하거나 대치하지 않습니다. 항목 안의 내용은 계속 편집할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo precisa deste item para iniciar, então o Fila não vai apagá-lo, movê-lo nem substituí-lo. Você ainda pode editar o que está dentro dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот объект нужен устройству для запуска, поэтому Fila не станет его удалять, перемещать или заменять. Содержимое внутри него по-прежнему можно изменять."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị cần mục này để khởi động, nên Fila sẽ không xóa, di chuyển hay thay thế nó. Bạn vẫn có thể chỉnh sửa nội dung bên trong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备启动需要此项目，因此 Fila 不会删除、移动或替换它。你仍可编辑其中的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置需要此項目才能啟動，因此 Fila 不會刪除、移動或取代它。你仍然可以編輯其中的內容。"
          }
        }
      }
    },
    "The device needs this item to start up, so Fila will not replace it. You can still edit what is inside it." : {
