    "Tap a checksum to view it in full. Touch and hold to copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مجموع التحقق لعرضه كاملًا. المس مع الاستمرار للنسخ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Prüfsumme, um sie vollständig anzuzeigen. Halte sie gedrückt, um sie zu kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a checksum to view it in full. Touch and hold to copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una suma de comprobación para verla completa. Mantén pulsado para copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une somme de contrôle pour l’afficher en entier. Touchez et maintenez pour copier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un checksum per vederlo per intero. Tieni premuto per copiarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックサムをタップすると全体を表示します。長押しするとコピーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크섬을 탭하면 전체를 볼 수 있습니다. 길게 누르면 복사됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma soma de verificação para vê-la por completo. Toque e mantenha pressionado para copiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите контрольную сумму, чтобы увидеть её полностью. Коснитесь и удерживайте, чтобы скопировать."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào tổng kiểm tra để xem đầy đủ. Chạm và giữ để sao chép."
