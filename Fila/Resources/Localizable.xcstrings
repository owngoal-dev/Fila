    "A symbolic link in this path cannot be followed. Choose the item's real location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تتبّع ارتباط رمزي في هذا المسار. اختر الموقع الحقيقي للعنصر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einem symbolischen Link in diesem Pfad kann nicht gefolgt werden. Wähle den tatsächlichen Ort des Objekts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A symbolic link in this path cannot be followed. Choose the item's real location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
