    "Drag to reorder. Turn off a place to hide it." : {
      "comment" : "Footer under the Presets list in Appearance settings. A place is one row of the Places list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لإعادة الترتيب. أوقف مكانًا لإخفائه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege Einträge, um sie neu anzuordnen. Deaktiviere einen Ort, um ihn auszublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to reorder. Turn off a place to hide it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Desactiva un lugar para ocultarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Désactivez un emplacement pour le masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Disattiva una posizione per nasconderla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。場所をオフにすると非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서를 변경하십시오. 위치를 끄면 숨겨집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
