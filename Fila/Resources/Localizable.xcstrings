    "The selection includes the same item more than once, or both a folder and an item inside it. Change the selection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمّن التحديد العنصر نفسه أكثر من مرة، أو يتضمّن مجلدًا وعنصرًا بداخله. غيّر التحديد وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
