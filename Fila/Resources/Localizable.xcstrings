    "Saved servers are listed under Servers in the sidebar. Removing one forgets its saved password and favorites; nothing on the server is changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الخوادم المحفوظة تحت «الخوادم» في الشريط الجانبي. إزالة أحدها تنسى كلمة سره المحفوظة ومفضلاته؛ لا يُغيَّر شيء على الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesicherte Server erscheinen in der Seitenleiste unter „Server“. Beim Entfernen werden das gesicherte Passwort und die Favoriten vergessen; auf dem Server wird nichts verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved servers are listed under Servers in the sidebar. Removing one forgets its saved password and favorites; nothing on the server is changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores guardados aparecen en «Servidores» en la barra lateral. Al eliminar uno se olvidan su contraseña guardada y sus favoritos; no se modifica nada en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs enregistrés figurent sous « Serveurs » dans la barre latérale. En supprimer un oublie son mot de passe enregistré et ses favoris ; rien n’est modifié sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server salvati sono elencati sotto Server nella barra laterale. Rimuoverne uno dimentica la password salvata e i preferiti; nulla sul server viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したサーバはサイドバーの「サーバ」に表示されます。削除すると保存したパスワードとお気に入りは忘れられます。サーバ上のものは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 서버는 사이드바의 ‘서버’ 아래에 표시됩니다. 제거하면 저장된 암호와 즐겨찾기가 삭제되며, 서버의 내용은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores salvos são listados em “Servidores” na barra lateral. Remover um esquece a senha salva e os favoritos; nada no servidor é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые серверы показаны в разделе «Серверы» боковой панели. При удалении забываются сохранённый пароль и избранное; на самом сервере ничего не меняется."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các máy chủ đã lưu được liệt kê dưới mục Máy chủ trong thanh bên. Xóa một máy chủ sẽ quên mật khẩu đã lưu và mục ưa thích; không có gì trên máy chủ bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的服务器会显示在边栏的“服务器”下。移除后会忘记其已保存的密码和收藏；服务器上的内容不会被改动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的伺服器列於側邊欄的「伺服器」中。移除後會忘記其已儲存的密碼和收藏；伺服器上的內容不會變更。"
          }
        }
      }
    },
