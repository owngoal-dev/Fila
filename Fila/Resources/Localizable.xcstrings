    "Copied, but %lld items could not be removed from the source and were kept there: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copied, but %1$lld items could not be removed from the source and were kept there: %2$@."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم النسخ، لكن تعذّرت إزالة %1$lld من العناصر من المصدر وبقيت هناك: %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert, aber %1$lld Objekte konnten an der Quelle nicht entfernt werden und blieben dort: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se copió, pero %1$lld elementos no se han podido eliminar del origen y se han conservado allí: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie effectuée, mais %1$lld éléments n’ont pas pu être retirés de la source et y ont été conservés : %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiati, ma %1$lld elementi non sono stati rimossi dall’origine e sono rimasti lì: %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしましたが、%1$lld 個の項目をコピー元から削除できず、そのまま残しました: %2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사했지만 항목 %1$lld개를 원본에서 제거하지 못해 그대로 두었습니다: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiado, mas %1$lld itens não puderam ser removidos da origem e foram mantidos lá: %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопировано, но %1$lld объектов не удалось удалить из источника, и они оставлены там: %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã sao chép, nhưng %1$lld mục không thể xóa khỏi nguồn và được giữ lại ở đó: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已复制，但有 %1$lld 个项目无法从来源移除并保留在原处：%2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拷貝，但有 %1$lld 個項目無法從來源移除，已保留在原處：%2$@。"
          }
        }
      }
    },
    "Copies a file or folder into another folder, as root, without replacing anything already there." : {
      "comment" : "What the Copy Item shortcut does, shown in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينسخ ملفًا أو مجلدًا إلى مجلد آخر بصلاحية الجذر، دون استبدال أي شيء موجود فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert eine Datei oder einen Ordner als Root in einen anderen Ordner, ohne vorhandene Objekte zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies a file or folder into another folder, as root, without replacing anything already there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un archivo o una carpeta dentro de otra carpeta, como root, sin sustituir nada de lo que ya haya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie un fichier ou un dossier dans un autre dossier, en tant que root, sans rien remplacer de ce qui s’y trouve déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un file o una cartella in un’altra cartella, come root, senza sostituire nulla di ciò che è già presente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルまたはフォルダを、既存の項目を置き換えずに、rootとして別のフォルダにコピーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 또는 폴더를 루트 권한으로 다른 폴더에 복사합니다. 이미 있는 항목은 대치하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia um arquivo ou pasta para outra pasta, como root, sem substituir nada que já esteja lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копирует файл или папку в другую папку от имени root, ничего в ней не заменяя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép một tệp hoặc thư mục vào thư mục khác, với quyền root, mà không thay thế bất kỳ thứ gì đã có ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 身份将文件或文件夹拷贝到另一个文件夹，不会覆盖其中已有的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 權限將檔案或檔案夾拷貝到另一個檔案夾，不會取代其中既有的項目。"
          }
        }
      }
    },
