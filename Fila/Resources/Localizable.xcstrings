    "Symbolic links were not followed, so items they point to were not searched." : {
      "comment" : "Footer under subfolder search results when the walk passed over at least one link to a directory without entering it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُتبع الارتباطات الرمزية، لذا لم يشمل البحث العناصر التي تشير إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbolischen Links wurde nicht gefolgt, daher wurden die Objekte, auf die sie zeigen, nicht durchsucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbolic links were not followed, so items they point to were not searched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han seguido los enlaces simbólicos, así que no se ha buscado en los elementos a los que apuntan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens symboliques n’ont pas été suivis : les éléments vers lesquels ils pointent n’ont donc pas été explorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I link simbolici non sono stati seguiti, quindi gli elementi a cui puntano non sono stati cercati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンボリックリンクはたどっていないため、リンク先の項目は検索されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심볼릭 링크를 따라가지 않았으므로, 링크가 가리키는 항목은 검색되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os links simbólicos não foram seguidos, portanto os itens para os quais eles apontam não foram buscados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символьные ссылки не раскрывались, поэтому объекты, на которые они указывают, не искались."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các liên kết tượng trưng không được đi theo, nên những mục chúng trỏ tới không được tìm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未跟随符号链接，因此未搜索链接指向的项目。"
          }
        },
        "zh-Hant" : {
