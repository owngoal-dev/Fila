    "Check the source and destination folders before trying again. Some items may already have been transferred." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من مجلدَي المصدر والوجهة قبل المحاولة مرة أخرى. قد تكون بعض العناصر قد نُقلت بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den Quell- und den Zielordner, bevor du es erneut versuchst. Einige Objekte wurden möglicherweise bereits übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the source and destination folders before trying again. Some items may already have been transferred."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba las carpetas de origen y destino antes de volver a intentarlo. Es posible que algunos elementos ya se hayan transferido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les dossiers source et de destination avant de réessayer. Certains éléments ont peut-être déjà été transférés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla le cartelle di origine e di destinazione prima di riprovare. Alcuni elementi potrebbero essere già stati trasferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度試す前に、元のフォルダと移動先のフォルダを確認してください。すでに転送された項目がある可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도하기 전에 원본 폴더와 대상 폴더를 확인하십시오. 일부 항목은 이미 전송되었을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique as pastas de origem e destino antes de tentar novamente. Alguns itens podem já ter sido transferidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте исходную папку и папку назначения, прежде чем повторить попытку. Некоторые объекты уже могли быть перенесены."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra thư mục nguồn và thư mục đích trước khi thử lại. Một số mục có thể đã được chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试前请先检查源文件夹和目标文件夹，部分项目可能已完成传输。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重試前請先檢查來源檔案夾和目標檔案夾，部分項目可能已完成傳輸。"
          }
        }
      }
    },
