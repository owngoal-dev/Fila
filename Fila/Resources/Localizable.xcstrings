    "One of these items no longer exists. Remove it from the clipboard before pasting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد أحد هذه العناصر موجودًا. أزله من الحافظة قبل اللصق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eines dieser Objekte existiert nicht mehr. Entferne es vor dem Einsetzen aus der Zwischenablage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of these items no longer exists. Remove it from the clipboard before pasting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de estos elementos ya no existe. Elimínalo del portapapeles antes de pegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’un de ces éléments n’existe plus. Retirez-le du presse-papiers avant de coller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno di questi elementi non esiste più. Rimuovilo dagli appunti prima di incollare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの項目のうち1件はすでに存在しません。ペーストする前にクリップボードから削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목 중 하나가 더 이상 존재하지 않습니다. 붙여넣기 전에 클립보드에서 제거하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um destes itens não existe mais. Remova-o da área de transferência antes de colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один из этих объектов больше не существует. Удалите его из буфера обмена перед вставкой."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trong các mục này không còn tồn tại. Hãy xóa nó khỏi bảng nháp trước khi dán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中一个项目已不存在。请先将其从剪贴板中移除，再粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中一個項目已不存在。請先將它從剪貼板移除，再進行貼上。"
          }
        }
      }
    },
