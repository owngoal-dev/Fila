    "This offset is past the end of the file. Enter 0x%llx or less." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الإزاحة تتجاوز نهاية الملف. أدخل 0x%llx أو أقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Offset liegt hinter dem Ende der Datei. Gib 0x%llx oder weniger ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This offset is past the end of the file. Enter 0x%llx or less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este desplazamiento supera el final del archivo. Introduce 0x%llx o menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce décalage dépasse la fin du fichier. Saisissez 0x%llx ou moins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo offset è oltre la fine del file. Inserisci 0x%llx o un valore inferiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
