    "Leaving now discards your changes. The file on disk is unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المغادرة الآن تتجاهل تغييراتك. يبقى الملف على القرص كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du jetzt gehst, werden deine Änderungen verworfen. Die Datei auf dem Datenträger bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaving now discards your changes. The file on disk is unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales ahora, se descartarán tus cambios. El archivo del disco no cambiará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter maintenant abandonne vos modifications. Le fichier sur le disque reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esci ora, le tue modifiche vengono perse. Il file su disco resta invariato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで戻ると、変更は破棄されます。ディスク上のファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 나가면 변경 사항이 폐기됩니다. 디스크의 파일은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
