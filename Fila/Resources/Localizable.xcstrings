    "Moves a file or folder into another folder, as root, without replacing anything already there." : {
      "comment" : "What the Move Item shortcut does, shown in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل ملفًا أو مجلدًا إلى مجلد آخر بصلاحية الجذر، دون استبدال أي شيء موجود فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt eine Datei oder einen Ordner als Root in einen anderen Ordner, ohne vorhandene Objekte zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves a file or folder into another folder, as root, without replacing anything already there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve un archivo o una carpeta a otra carpeta, como root, sin sustituir nada de lo que ya haya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace un fichier ou un dossier dans un autre dossier, en tant que root, sans rien remplacer de ce qui s’y trouve déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta un file o una cartella in un’altra cartella, come root, senza sostituire nulla di ciò che è già presente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルまたはフォルダを、既存の項目を置き換えずに、rootとして別のフォルダに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 또는 폴더를 루트 권한으로 다른 폴더로 이동합니다. 이미 있는 항목은 대치하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move um arquivo ou pasta para outra pasta, como root, sem substituir nada que já esteja lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещает файл или папку в другую папку от имени root, ничего в ней не заменяя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển một tệp hoặc thư mục vào thư mục khác, với quyền root, mà không thay thế bất kỳ thứ gì đã có ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 身份将文件或文件夹移动到另一个文件夹，不会覆盖其中已有的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 權限將檔案或檔案夾移到另一個檔案夾，不會取代其中既有的項目。"
          }
        }
      }
    },
    "Moves a file or folder to the trash, or deletes it permanently." : {
      "comment" : "What the Delete Item shortcut does, shown in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل ملفًا أو مجلدًا إلى المهملات، أو يحذفه نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt eine Datei oder einen Ordner in den Papierkorb oder löscht sie endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves a file or folder to the trash, or deletes it permanently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve un archivo o una carpeta a la papelera, o lo elimina permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place un fichier ou un dossier dans la corbeille, ou le supprime définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta un file o una cartella nel Cestino, oppure lo elimina definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルまたはフォルダをゴミ箱に入れるか、完全に削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 또는 폴더를 휴지통으로 이동하거나 완전히 삭제합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move um arquivo ou pasta para a Lixeira, ou o apaga definitivamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещает файл или папку в Корзину либо удаляет безвозвратно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển một tệp hoặc thư mục vào thùng rác, hoặc xóa vĩnh viễn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件或文件夹移到废纸篓，或将其永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將檔案或檔案夾移到垃圾桶，或永久刪除。"
          }
        }
      }
    },
