          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统安装器将安装“%1$@”（%2$@），并替换相同标识符的应用。未为本设备签名的应用需要 AppSync Unified。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統安裝程式將會安裝「%@」（%@），並取代任何識別碼相同的 App。未針對此裝置簽署的 App 需要 AppSync Unified。"
