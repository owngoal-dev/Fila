    "Anyone connecting must enter this name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على كل من يتصل إدخال هذا الاسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer sich verbindet, muss diesen Namen eingeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone connecting must enter this name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se conecte deberá introducir este nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne qui se connecte doit saisir ce nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi si connette deve inserire questo nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続する人はこの名前を入力する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결하는 사람은 이 이름을 입력해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem se conectar precisa digitar este nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все подключающиеся должны вводить это имя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bất kỳ ai kết nối đều phải nhập tên này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接时必须输入此用户名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人連線時都必須輸入此名稱。"
          }
        }
      }
    },
    "Anyone connecting must enter this password. Leave it empty to generate a new one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على كل من يتصل إدخال كلمة السر هذه. اتركها فارغة لتوليد كلمة سر جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer sich verbindet, muss dieses Passwort eingeben. Lass es leer, um ein neues zu erzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone connecting must enter this password. Leave it empty to generate a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se conecte deberá introducir esta contraseña. Déjala vacía para generar una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne qui se connecte doit saisir ce mot de passe. Laissez le champ vide pour en générer un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi si connette deve inserire questa password. Lasciala vuota per generarne una nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続する人はこのパスワードを入力する必要があります。空欄にすると新しいパスワードが生成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결하는 사람은 이 암호를 입력해야 합니다. 비워 두면 새로운 암호가 생성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem se conectar precisa digitar esta senha. Deixe em branco para gerar uma nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все подключающиеся должны вводить этот пароль. Оставьте поле пустым, чтобы создать новый."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bất kỳ ai kết nối đều phải nhập mật khẩu này. Để trống để tạo mật khẩu mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接时必须输入此密码。留空将重新生成一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人連線時都必須輸入此密碼。留空則會產生新的密碼。"
          }
        }
      }
    },
    "Aperture" : {
      "comment" : "EXIF row label: the lens aperture (f-number) a photo was taken at.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتحة العدسة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blende"
          }
        },
        "en" : {
