    "The signature of “%@” was rejected. Install AppSync Unified on this device or open the file in TrollStore." : {
      "comment" : "Body of the Cannot Install card after installd rejected the package's code signature. %@ is the app name. Blunt on purpose: the fix is a device-side tool, not a retry.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض توقيع ”%@“. ثبّت AppSync Unified على هذا الجهاز أو افتح الملف في TrollStore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Signatur von „%@“ wurde abgelehnt. Installiere AppSync Unified auf diesem Gerät oder öffne die Datei in TrollStore."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The signature of “%@” was rejected. Install AppSync Unified on this device or open the file in TrollStore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha rechazado la firma de “%@”. Instala AppSync Unified en este dispositivo o abre el archivo en TrollStore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de « %@ » a été refusée. Installez AppSync Unified sur cet appareil ou ouvrez le fichier dans TrollStore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma di “%@” è stata rifiutata. Installa AppSync Unified su questo dispositivo, oppure apri il file in TrollStore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の署名は拒否されました。このデバイスにAppSync Unifiedをインストールするか、ファイルをTrollStoreで開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 서명이 거부되었습니다. 이 기기에 AppSync Unified를 설치하거나 TrollStore에서 파일을 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
