    "Part of the path is a file instead of a folder. Choose an existing destination folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جزء من المسار ملف وليس مجلدًا. اختر مجلد وجهة موجودًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil des Pfads ist eine Datei statt eines Ordners. Wähle einen vorhandenen Zielordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part of the path is a file instead of a folder. Choose an existing destination folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte de la ruta es un archivo en lugar de una carpeta. Selecciona una carpeta de destino existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie du chemin est un fichier et non un dossier. Choisissez un dossier de destination existant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte del percorso è un file anziché una cartella. Scegli una cartella di destinazione esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスの一部がフォルダではなくファイルです。既存の移動先フォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로의 일부가 폴더가 아닌 파일입니다. 이미 있는 대상 폴더를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte do caminho é um arquivo, não uma pasta. Escolha uma pasta de destino existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть пути указывает на файл, а не на папку. Выберите существующую папку назначения."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phần của đường dẫn là tệp chứ không phải thư mục. Hãy chọn một thư mục đích đã có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
