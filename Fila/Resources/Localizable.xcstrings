    "That is not a valid offset. Enter a decimal offset, or a hexadecimal offset with a 0x prefix." : {
      "comment" : "Error shown when the Go to Offset input in the hex viewer cannot be read as a number.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه ليست إزاحة صالحة. أدخل إزاحة عشرية، أو إزاحة ست عشرية ببادئة 0x."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist kein gültiger Offset. Gib einen dezimalen Offset ein oder einen hexadezimalen Offset mit dem Präfix 0x."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That is not a valid offset. Enter a decimal offset, or a hexadecimal offset with a 0x prefix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese desplazamiento no es válido. Introduce un desplazamiento decimal, o un desplazamiento hexadecimal con el prefijo 0x."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce décalage n’est pas valide. Saisissez un décalage décimal, ou un décalage hexadécimal précédé de 0x."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offset non valido. Inserisci un offset decimale, oppure un offset esadecimale con prefisso 0x."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なオフセットではありません。10進数のオフセット、または 0x で始まる16進数のオフセットを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "올바른 오프셋이 아닙니다. 10진수 오프셋 또는 0x로 시작하는 16진수 오프셋을 입력하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse deslocamento não é válido. Digite um deslocamento decimal ou um deslocamento hexadecimal com o prefixo 0x."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недопустимое смещение. Введите десятичное смещение или шестнадцатеричное смещение с префиксом 0x."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đó không phải là offset hợp lệ. Hãy nhập offset thập phân, hoặc offset thập lục phân với tiền tố 0x."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏移量无效。请输入十进制偏移量，或以 0x 为前缀的十六进制偏移量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏移值無效。請輸入十進位偏移值，或以 0x 開頭的十六進位偏移值。"
          }
        }
      }
    },
    "The archive changed while it was open. Open it again." : {
      "comment" : "Extraction refusal: the entry at this position is no longer the one that was ticked, so nothing was written. Keep it specific — this is a refusal, not a generic failure.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الأرشيف أثناء فتحه. افتحه مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv hat sich geändert, während es geöffnet war. Öffne es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive changed while it was open. Open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo comprimido ha cambiado mientras estaba abierto. Ábrelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archive a changé pendant qu’elle était ouverte. Ouvrez-la à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archivio è cambiato mentre era aperto. Aprilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブが開いている間に変更されました。もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아카이브가 열려 있는 동안 변경되었습니다. 다시 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo compactado mudou enquanto estava aberto. Abra-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив изменился, пока был открыт. Откройте его заново."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kho lưu trữ đã thay đổi khi đang mở. Hãy mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩包在打开期间发生了变化。请重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮檔在開啟期間已變更，因此未寫入任何內容。請重新打開它。"
          }
        }
      }
    },
    "The archive password is missing or incorrect. Enter the password and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمة سر الأرشيف مفقودة أو غير صحيحة. أدخل كلمة السر وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archivpasswort fehlt oder ist falsch. Gib das Passwort ein und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive password is missing or incorrect. Enter the password and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la contraseña del archivo comprimido o es incorrecta. Introdúcela e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
