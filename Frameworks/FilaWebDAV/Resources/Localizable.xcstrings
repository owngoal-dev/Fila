          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản này không được phép làm điều đó. Hãy thử tài khoản khác hoặc chọn mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
