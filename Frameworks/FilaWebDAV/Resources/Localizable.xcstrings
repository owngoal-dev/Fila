    "That item is not on the server. Refresh the folder, or choose another item." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنصر غير موجود على الخادم. حدّث المجلد أو اختر عنصرًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Objekt ist nicht auf dem Server. Aktualisiere den Ordner oder wähle ein anderes Objekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That item is not on the server. Refresh the folder, or choose another item."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese elemento no está en el servidor. Actualiza la carpeta o selecciona otro elemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément ne se trouve pas sur le serveur. Actualisez le dossier ou choisissez un autre élément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elemento non è sul server. Aggiorna la cartella o scegli un altro elemento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この項目はサーバにありません。フォルダを再読み込みするか、別の項目を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 항목이 서버에 없습니다. 폴더를 새로 고치거나 다른 항목을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este item não está no servidor. Atualize a pasta ou escolha outro item."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого объекта нет на сервере. Обновите папку или выберите другой объект."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục đó không có trên máy chủ. Hãy làm mới thư mục hoặc chọn mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该项目不在服务器上。请刷新文件夹，或选择其他项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該項目不在伺服器上。請重新整理檔案夾，或選擇其他項目。"
          }
        }
      }
    },
    "The connection to the server was closed. Try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُغلق الاتصال بالخادم. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zum Server wurde geschlossen. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection to the server was closed. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cerrado la conexión con el servidor. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion au serveur a été fermée. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
