{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nSave the server anyway? It can be opened later when it is reachable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nهل تريد حفظ الخادم على أي حال؟ يمكن فتحه لاحقًا عندما يصبح متاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nServer trotzdem sichern? Er kann später geöffnet werden, sobald er erreichbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSave the server anyway? It can be opened later when it is reachable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n¿Guardar el servidor de todos modos? Podrás abrirlo más tarde, cuando esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nEnregistrer le serveur quand même ? Il pourra être ouvert plus tard, lorsqu’il sera joignable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSalvare comunque il server? Potrà essere aperto in seguito, quando sarà raggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nこのままサーバを保存しますか？ 接続できるようになったら、あとで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n그래도 서버를 저장하겠습니까? 연결할 수 있게 되면 나중에 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSalvar o servidor mesmo assim? Ele poderá ser aberto depois, quando estiver acessível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nВсё равно сохранить сервер? Его можно будет открыть позже, когда он станет доступен."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVẫn lưu máy chủ? Bạn có thể mở sau khi máy chủ truy cập được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n仍要保存此服务器吗？之后可在其可访问时打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n仍要儲存此伺服器嗎？之後可在其可連線時開啟。"
          }
        }
      }
    },
