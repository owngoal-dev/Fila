    "Leave the user name empty for a server without accounts. The password is kept in this device's keychain and never written anywhere else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك اسم المستخدم فارغًا للخادم الذي لا يستخدم حسابات. تُحفظ كلمة السر في سلسلة مفاتيح هذا الجهاز ولا تُكتب في أي مكان آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Benutzernamen leer, wenn der Server keine Accounts verwendet. Das Passwort liegt im Schlüsselbund dieses Geräts und wird nirgendwo sonst gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the user name empty for a server without accounts. The password is kept in this device's keychain and never written anywhere else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el nombre de usuario vacío si el servidor no usa cuentas. La contraseña se guarda en el llavero de este dispositivo y no se escribe en ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le nom d’utilisateur vide pour un serveur sans comptes. Le mot de passe est conservé dans le trousseau de cet appareil et n’est écrit nulle part ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto il nome utente per un server senza account. La password è conservata nel portachiavi di questo dispositivo e non viene scritta altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントのないサーバではユーザ名を空欄にしてください。パスワードはこのデバイスのキーチェーンに保存され、ほかの場所には書き込まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 없는 서버라면 사용자 이름을 비워 두십시오. 암호는 이 기기의 키체인에 보관되며 다른 곳에는 기록되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o nome de usuário vazio para um servidor sem contas. A senha é guardada nas chaves deste dispositivo e nunca é gravada em outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте имя пользователя пустым, если на сервере нет учётных записей. Пароль хранится в связке ключей этого устройства и больше нигде не записывается."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trống tên người dùng nếu máy chủ không dùng tài khoản. Mật khẩu được lưu trong chuỗi khóa của thiết bị này và không được ghi ở nơi nào khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器没有账户时，请将用户名留空。密码保存在此设备的钥匙串中，不会写入其他任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器沒有帳號時，請將使用者名稱留空。密碼儲存在此裝置的鑰匙圈中，不會寫入其他任何地方。"
          }
        }
      }
    },
