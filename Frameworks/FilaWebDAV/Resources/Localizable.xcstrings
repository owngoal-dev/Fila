          }
        }
      }
    },
    "This address does not answer as a WebDAV server. Check the full address, including its path, such as /dav for Alist." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان لا يستجيب كخادم WebDAV. تحقق من العنوان الكامل بما في ذلك مساره، مثل ‎/dav‎ في Alist."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse antwortet nicht als WebDAV-Server. Prüfe die vollständige Adresse einschließlich Pfad, etwa /dav bei Alist."
          }
        },
        "en" : {
          "stringUnit" : {
