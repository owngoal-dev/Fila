    },
    "The server’s certificate is not trusted by this device. Use an address with a valid certificate, or use http on a trusted network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شهادة الخادم غير موثوقة على هذا الجهاز. استخدم عنوانًا بشهادة صالحة، أو استخدم http على شبكة موثوقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat des Servers wird von diesem Gerät nicht als vertrauenswürdig eingestuft. Verwende eine Adresse mit gültigem Zertifikat oder http in einem vertrauenswürdigen Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server’s certificate is not trusted by this device. Use an address with a valid certificate, or use http on a trusted network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no confía en el certificado del servidor. Usa una dirección con un certificado válido o usa http en una red de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat du serveur n’est pas approuvé par cet appareil. Utilisez une adresse dotée d’un certificat valide, ou http sur un réseau de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il certificato del server non è considerato attendibile da questo dispositivo. Usa un indirizzo con un certificato valido oppure http su una rete attendibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはサーバの証明書を信頼していません。有効な証明書のあるアドレスを使うか、信頼できるネットワークで http を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 서버의 인증서를 신뢰하지 않습니다. 유효한 인증서가 있는 주소를 사용하거나, 신뢰할 수 있는 네트워크에서 http를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não confia no certificado do servidor. Use um endereço com um certificado válido ou use http em uma rede confiável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство не доверяет сертификату сервера. Укажите адрес с действительным сертификатом или используйте http в доверенной сети."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này không tin cậy chứng chỉ của máy chủ. Hãy dùng địa chỉ có chứng chỉ hợp lệ, hoặc dùng http trên mạng đáng tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不信任服务器的证书。请使用带有效证书的地址，或在可信网络中使用 http。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置不信任伺服器的憑證。請使用具有效憑證的位址，或在可信任的網路中使用 http。"
          }
        }
      }
    },
    "This account is not allowed to do that. Try another account, or choose a different item." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُسمح لهذا الحساب بذلك. جرّب حسابًا آخر أو اختر عنصرًا مختلفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
