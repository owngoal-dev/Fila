    "Changing the address creates a new sidebar item with its own favorites." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تغيير العنوان إلى إنشاء عنصر جديد في الشريط الجانبي بمفضلاته الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern der Adresse erzeugt einen neuen Seitenleisten-Eintrag mit eigenen Favoriten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the address creates a new sidebar item with its own favorites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar la dirección se crea un nuevo elemento en la barra lateral con sus propios favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier l’adresse crée un nouvel élément dans la barre latérale, avec ses propres favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare l’indirizzo crea un nuovo elemento nella barra laterale con i propri preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスを変更すると、独自のお気に入りを持つ新しいサイドバー項目が作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소를 변경하면 자체 즐겨찾기가 있는 새 사이드바 항목이 생성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o endereço cria um novo item na barra lateral com seus próprios favoritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена адреса создаёт новый пункт боковой панели со своими избранными."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi địa chỉ sẽ tạo mục thanh bên mới với mục ưa thích riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改地址会创建拥有独立收藏的新边栏项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改位址會在側邊欄建立擁有獨立喜好項目的新項目。"
          }
        }
      }
    },
