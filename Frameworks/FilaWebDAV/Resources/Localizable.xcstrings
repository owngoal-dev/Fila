    "An http address outside the local network cannot be used. Use the server’s https address instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخدام عنوان http خارج الشبكة المحلية. استخدم عنوان https الخاص بالخادم بدلًا منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine http-Adresse außerhalb des lokalen Netzwerks kann nicht verwendet werden. Verwende stattdessen die https-Adresse des Servers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An http address outside the local network cannot be used. Use the server’s https address instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede usar una dirección http fuera de la red local. Usa en su lugar la dirección https del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse http en dehors du réseau local ne peut pas être utilisée. Utilisez plutôt l’adresse https du serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è possibile usare un indirizzo http al di fuori della rete locale. Usa invece l’indirizzo https del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワーク外の http アドレスは使用できません。代わりにサーバの https アドレスを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크 밖의 http 주소는 사용할 수 없습니다. 대신 서버의 https 주소를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível usar um endereço http fora da rede local. Use o endereço https do servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес http за пределами локальной сети использовать нельзя. Укажите https-адрес сервера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể dùng địa chỉ http bên ngoài mạng cục bộ. Hãy dùng địa chỉ https của máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用局域网以外的 http 地址。请改用服务器的 https 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用區域網路以外的 http 位址。請改用伺服器的 https 位址。"
          }
        }
      }
    },
    "An item with that name already exists. Choose a different name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد عنصر بهذا الاسم بالفعل. اختر اسمًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Objekt mit diesem Namen existiert bereits. Wähle einen anderen Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An item with that name already exists. Choose a different name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un elemento con ese nombre. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément portant ce nom existe déjà. Choisissez un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un elemento con quel nome. Scegli un nome diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前の項目がすでに存在します。別の名前を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
