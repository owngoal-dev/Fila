    "SMB 2 over TCP port 445, as Windows, macOS, Samba and most NAS devices serve it. SMB 1 is not supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 عبر منفذ TCP 445، كما تقدمه Windows وmacOS وSamba ومعظم أجهزة NAS. SMB 1 غير مدعوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 über TCP-Port 445, wie ihn Windows, macOS, Samba und die meisten NAS-Geräte anbieten. SMB 1 wird nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 por el puerto TCP 445, como lo sirven Windows, macOS, Samba y la mayoría de los NAS. SMB 1 no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 sur le port TCP 445, tel que le servent Windows, macOS, Samba et la plupart des NAS. SMB 1 n'est pas pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 sulla porta TCP 445, come lo offrono Windows, macOS, Samba e la maggior parte dei NAS. SMB 1 non è supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows、macOS、Samba、ほとんどの NAS が提供する TCP ポート 445 の SMB 2 です。SMB 1 は対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows, macOS, Samba 및 대부분의 NAS가 제공하는 TCP 포트 445의 SMB 2입니다. SMB 1은 지원되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 pela porta TCP 445, como servem Windows, macOS, Samba e a maioria dos NAS. SMB 1 não é compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 через TCP-порт 445, как его предоставляют Windows, macOS, Samba и большинство NAS. SMB 1 не поддерживается."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMB 2 qua cổng TCP 445, như Windows, macOS, Samba và hầu hết NAS cung cấp. Không hỗ trợ SMB 1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 TCP 445 端口的 SMB 2，Windows、macOS、Samba 和大多数 NAS 均提供。不支持 SMB 1。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 TCP 445 連接埠的 SMB 2，Windows、macOS、Samba 和大多數 NAS 均提供。不支援 SMB 1。"
          }
        }
      }
    },
