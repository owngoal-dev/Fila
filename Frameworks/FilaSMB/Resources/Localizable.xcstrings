{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nSave the share anyway? It can be opened later when the server is reachable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nهل تريد حفظ المشاركة على أي حال؟ يمكن فتحها لاحقًا عندما يصبح الخادم متاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nFreigabe trotzdem sichern? Sie kann später geöffnet werden, sobald der Server erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n¿Guardar el recurso de todos modos? Se podrá abrir más tarde cuando el servidor esté accesible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nEnregistrer le partage quand même ? Il pourra être ouvert plus tard, lorsque le serveur sera joignable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSalvare comunque la condivisione? Potrà essere aperta più tardi, quando il server è raggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nそれでも共有を保存しますか？サーバに接続できるようになれば、後で開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n그래도 공유를 저장하시겠습니까? 서버에 연결할 수 있으면 나중에 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSalvar o compartilhamento mesmo assim? Ele poderá ser aberto depois, quando o servidor estiver acessível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nВсё равно сохранить общий ресурс? Его можно будет открыть позже, когда сервер будет доступен."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVẫn lưu chia sẻ này? Có thể mở sau khi máy chủ truy cập được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n仍要保存该共享吗？服务器可访问后可以稍后打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n仍要儲存該共享嗎？伺服器可連線時可稍後開啟。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSave the share anyway? It can be opened later when the server is reachable."
          }
        }
      }
    },
