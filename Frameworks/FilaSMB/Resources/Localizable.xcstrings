    "Asking %@ what it shares." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ سؤال %@ عما يشاركه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird nach seinen Freigaben gefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntando a %@ qué comparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à %@ ce qu'il partage."
          }
        },
        "it" : {
