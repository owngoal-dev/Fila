{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nSave the share anyway? It can be opened later once the server answers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nهل تريد حفظ المشاركة على أي حال؟ يمكن فتحها لاحقًا عندما يستجيب الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nFreigabe trotzdem sichern? Sie kann später geöffnet werden, sobald der Server antwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n¿Guardar el recurso compartido de todos modos? Podrá abrirse más tarde cuando el servidor responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nEnregistrer le partage quand même ? Il pourra être ouvert plus tard, quand le serveur répondra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSalvare comunque la condivisione? Potrà essere aperta più tardi, quando il server risponderà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nそれでも共有を保存しますか？サーバが応答すれば後で開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n그래도 공유를 저장하시겠습니까? 서버가 응답하면 나중에 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSalvar o compartilhamento mesmo assim? Ele poderá ser aberto depois, quando o servidor responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nВсё равно сохранить общий ресурс? Его можно будет открыть позже, когда сервер ответит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVẫn lưu chia sẻ này? Có thể mở sau khi máy chủ phản hồi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n仍要保存该共享吗？服务器响应后可以稍后打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n仍要儲存該共享嗎？伺服器回應後可以稍後開啟。"
          }
        }
      }
    },
    "A guest session has no account. Servers that require one refuse it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسة الضيف لا تملك حسابًا. الخوادم التي تتطلب حسابًا ترفضها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gastsitzung hat kein Konto. Server, die eines verlangen, lehnen sie ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión de invitado no tiene cuenta. Los servidores que la exigen la rechazan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session invité n'a pas de compte. Les serveurs qui en exigent un la refusent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessione ospite non ha un account. I server che ne richiedono uno la rifiutano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストセッションにはアカウントがありません。アカウントが必要なサーバは拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트 세션에는 계정이 없습니다. 계정을 요구하는 서버는 거부합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sessão de convidado não tem conta. Servidores que exigem uma a recusam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гостевой сеанс не имеет учётной записи. Серверы, которым она нужна, его отклоняют."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên khách không có tài khoản. Máy chủ yêu cầu tài khoản sẽ từ chối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访客会话没有账户。要求账户的服务器会拒绝它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪客工作階段沒有帳號。要求帳號的伺服器會拒絕它。"
          }
        }
      }
    },
