    "The password is kept in this device's keychain and never written anywhere else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ كلمة السر في سلسلة مفاتيح هذا الجهاز ولا تُكتب في أي مكان آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort liegt im Schlüsselbund dieses Geräts und wird nirgendwo sonst gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se guarda en el llavero de este dispositivo y nunca se escribe en otro lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est conservé dans le trousseau de cet appareil et n'est écrit nulle part ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password è conservata nel portachiavi di questo dispositivo e non viene scritta altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはこのデバイスのキーチェーンに保存され、他の場所には書き込まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 이 기기의 키체인에 보관되며 다른 곳에는 기록되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha fica nas chaves deste dispositivo e nunca é gravada em outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль хранится в связке ключей этого устройства и больше нигде не записывается."
          }
