    "Connecting to %@ on %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ الاتصال بـ %1$@ على %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung mit %1$@ auf %2$@ wird hergestellt."
          }
