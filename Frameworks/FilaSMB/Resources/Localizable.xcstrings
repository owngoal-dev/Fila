    "Changing the server or share creates a new sidebar item with its own favorites." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الخادم أو المشاركة ينشئ عنصرًا جديدًا في الشريط الجانبي بمفضلاته الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern von Server oder Freigabe erzeugt einen neuen Seitenleisten-Eintrag mit eigenen Favoriten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el servidor o el recurso crea un elemento nuevo en la barra lateral, con sus propios favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer le serveur ou le partage crée un nouvel élément dans la barre latérale, avec ses propres favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare il server o la condivisione crea un nuovo elemento nella barra laterale con i propri preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバや共有を変更すると、独自のお気に入りを持つ新しいサイドバー項目が作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버나 공유를 변경하면 자체 즐겨찾기를 가진 새 사이드바 항목이 만들어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o servidor ou o compartilhamento cria um novo item na barra lateral com favoritos próprios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена сервера или ресурса создаёт новый пункт боковой панели со своими избранными."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi máy chủ hoặc chia sẻ sẽ tạo mục thanh bên mới với mục ưa thích riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改服务器或共享会创建拥有独立收藏的新边栏项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改伺服器或共享會在側邊欄建立擁有獨立喜好項目的新項目。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the server or share creates a new sidebar item with its own favorites."
          }
        }
      }
    },
