    "Changing the server or the share makes a new entry with its own favorites." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الخادم أو المشاركة ينشئ إدخالًا جديدًا بمفضلاته الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Server oder eine andere Freigabe ergibt einen neuen Eintrag mit eigenen Favoriten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el servidor o el recurso crea una entrada nueva con sus propios favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer le serveur ou le partage crée une nouvelle entrée avec ses propres favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare il server o la condivisione crea una nuova voce con i propri preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバや共有を変更すると、独自のお気に入りを持つ新しい項目になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버나 공유를 변경하면 자체 즐겨찾기를 가진 새 항목이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o servidor ou o compartilhamento cria uma nova entrada com favoritos próprios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена сервера или ресурса создаёт новую запись со своими избранными."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi máy chủ hoặc chia sẻ sẽ tạo mục mới với mục ưa thích riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改服务器或共享会创建拥有独立收藏的新条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改伺服器或共享會建立擁有獨立喜好項目的新項目。"
          }
        }
      }
    },
