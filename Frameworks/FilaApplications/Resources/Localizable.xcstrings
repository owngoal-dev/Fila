    "iOS could not open this app. It may be unavailable or may not have an interface." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على iOS فتح هذا التطبيق. قد يكون غير متاح أو لا يحتوي على واجهة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS konnte diese App nicht öffnen. Sie ist möglicherweise nicht verfügbar oder hat keine Benutzeroberfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no pudo abrir esta app. Puede que no esté disponible o que no tenga interfaz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS n’a pas pu ouvrir cette app. Elle est peut-être indisponible ou ne possède pas d’interface."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non ha potuto aprire questa app. Potrebbe non essere disponibile o non avere un’interfaccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS はこのアプリを開けませんでした。利用できないか、画面を持たないアプリの可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서 이 앱을 열 수 없습니다. 앱을 사용할 수 없거나 인터페이스가 없을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não conseguiu abrir este app. Ele pode estar indisponível ou não ter uma interface."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не удалось открыть это приложение. Возможно, оно недоступно или не имеет интерфейса."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS không thể mở ứng dụng này. Ứng dụng có thể không khả dụng hoặc không có giao diện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 无法打开此应用。它可能不可用，或没有可显示的界面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 無法開啟此 App。它可能無法使用，或沒有可顯示的介面。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS could not open this app. It may be unavailable or may not have an interface."
          }
        }
      }
    },
    "“%@” is not an app package. Choose an .ipa that contains one app." : {
      "comment" : "Error shown when Install… is used on an .ipa whose archive has no single app bundle. %@ is the file name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@“ ليس حزمة تطبيق. اختر ملف .ipa يحتوي على تطبيق واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist kein App-Paket. Wähle eine .ipa, die genau eine App enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un paquete de app. Selecciona un .ipa que contenga una sola app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un paquet d’app. Choisissez un .ipa contenant une seule app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un pacchetto di app. Scegli un .ipa che contiene una sola app."
          }
