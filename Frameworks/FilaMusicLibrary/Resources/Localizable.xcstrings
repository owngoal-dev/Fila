    "Choose a playable audio file without copy protection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ملفًا صوتيًا قابلًا للتشغيل وغير محمي ضد النسخ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine abspielbare Audiodatei ohne Kopierschutz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo de audio reproducible y sin protección anticopia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fichier audio lisible et sans protection contre la copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un file audio riproducibile e senza protezione anticopia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー保護されていない、再生可能なオーディオファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사 방지가 적용되지 않은 재생 가능한 오디오 파일을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um arquivo de áudio reproduzível e sem proteção contra cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите воспроизводимый аудиофайл без защиты от копирования."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tệp âm thanh có thể phát và không được bảo vệ chống sao chép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择可以播放且没有拷贝保护的音频文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇可以播放且沒有拷貝保護的音訊檔案。"
          }
        }
      }
    },
