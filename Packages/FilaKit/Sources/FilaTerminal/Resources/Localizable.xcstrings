          "stringUnit" : {
            "state" : "translated",
            "value" : "root としてターミナルセッションを開始するには認証してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "root로 터미널 세션을 시작하려면 인증하세요."
          }
