    "This program could not be started. Check that it exists and can be run." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر بدء هذا البرنامج. تحقق من وجوده ومن إمكانية تشغيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Programm konnte nicht gestartet werden. Prüfe, ob es existiert und ausgeführt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This program could not be started. Check that it exists and can be run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido iniciar este programa. Comprueba que existe y que se puede ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce programme n’a pas pu être lancé. Vérifiez qu’il existe et qu’il peut être exécuté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile avviare questo programma. Verifica che esista e che sia eseguibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプログラムは起動できませんでした。存在しているか、実行できるかを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로그램을 시작할 수 없습니다. 프로그램이 존재하고 실행할 수 있는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar este programa. Verifique se ele existe e pode ser executado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить эту программу. Проверьте, что она существует и может быть запущена."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khởi chạy chương trình này. Hãy kiểm tra xem nó có tồn tại và có chạy được không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动此程序。请检查程序是否存在且可执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法啟動此程式。請確認它存在且可以執行。"
          }
        }
      }
