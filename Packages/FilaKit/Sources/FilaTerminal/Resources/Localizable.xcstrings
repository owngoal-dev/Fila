  "strings" : {
    "Authenticate to run a terminal session as root." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادق على هويتك لبدء جلسة طرفية بصلاحيات root."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiziere dich, um eine Terminalsitzung als root zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate to run a terminal session as root."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentícate para iniciar una sesión de terminal como root."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous pour lancer une session de terminal en tant que root."
