// `XPC_TYPE_DICTIONARY`, `XPC_ARRAY_APPEND` and `XPC_ERROR_CONNECTION_*` are C
// macros over libSystem globals that have existed since iOS 8. The iOS 27 SDK
// also ships a Swift overlay for XPC, and in Swift those same spellings resolve
// to accessors exported by `/usr/lib/swift/libswiftXPC.dylib` — a library the
// system first shipped after iOS 15. One use of one of them turns the overlay's
// load command from weak into required, and dyld then kills the process at
// launch on iOS 15: "Library not loaded: /usr/lib/swift/libswiftXPC.dylib".
//
// So the macros are read through C, where they are still the old globals, and
// no Swift file in this project names them. See `FilaXPC` in FilaProtocol.
module CFilaXPC [system] {
    header "shim.h"
    export *
}
