    "Unable to save all files. Open Fila to view any that were saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to save all files. Open Fila to view any that were saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存所有文件。打开 Fila 即可查看已保存的文件。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ جميع الملفات. افتح Fila لعرض ما تم حفظه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnten nicht alle Dateien gesichert werden. Öffne Fila, um die gesicherten Dateien anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido guardar todos los archivos. Abre Fila para ver los que sí se han guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer tous les fichiers. Ouvrez Fila pour afficher ceux qui ont été enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare tutti i file. Apri Fila per vedere quelli salvati."
