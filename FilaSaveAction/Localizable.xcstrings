    "Saved %lld of %lld files to Fila’s Inbox." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved %1$lld of %2$lld files to Fila’s Inbox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存 %1$lld / %2$lld 个文件到 Fila 收件箱。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ %1$lld من %2$lld ملفات في صندوق وارد Fila."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Dateien wurden in Filas Eingang gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han guardado %1$lld de %2$lld archivos en la bandeja de entrada de Fila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld fichiers sur %2$lld ont été enregistrés dans la boîte de réception de Fila."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvati %1$lld di %2$lld file nella casella in entrata di Fila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 個中 %1$lld 個のファイルをFilaの受信ボックスに保存しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 %2$lld개 중 %1$lld개를 Fila 수신함에 저장했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld arquivos salvos na caixa de entrada do Fila."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В папку «Входящие» Fila сохранено %1$lld из %2$lld файлов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu %1$lld trong %2$lld tệp vào Hộp thư đến của Fila."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存 %1$lld / %2$lld 個檔案到 Fila 收件匣。"
          }
        }
      }
    },
    "Saved to Fila’s Inbox. Open Fila to view or move the files." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved to Fila’s Inbox. Open Fila to view or move the files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存到 Fila 收件箱。打开 Fila 即可查看或移动文件。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الحفظ في صندوق وارد Fila. افتح Fila لعرض الملفات أو نقلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Filas Eingang gesichert. Öffne Fila, um die Dateien anzuzeigen oder zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha guardado en la bandeja de entrada de Fila. Abre Fila para ver o mover los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré dans la boîte de réception de Fila. Ouvrez Fila pour afficher ou déplacer les fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato nella casella in entrata di Fila. Apri Fila per vedere o spostare i file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filaの受信ボックスに保存しました。ファイルを表示または移動するにはFilaを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila 수신함에 저장했습니다. 파일을 보거나 옮기려면 Fila를 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo na caixa de entrada do Fila. Abra o Fila para ver ou mover os arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено в папку «Входящие» Fila. Откройте Fila, чтобы просмотреть или переместить файлы."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu vào Hộp thư đến của Fila. Hãy mở Fila để xem hoặc di chuyển tệp."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存到 Fila 收件匣。開啟 Fila 即可查看或移動檔案。"
          }
        }
      }
    },
